# Copy this file to ".env" in this same folder and fill in your key.
# .env is gitignored so it's safe to keep the real key here.

GEMINI_API_KEY=your-real-key-here

# Which model drives System Control: gemini (default) or groq.
# VESPER_REASONER=gemini
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=your-groq-key-here   # only needed if VESPER_REASONER=groq
# GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides — usually fine to leave as-is:
# VESPER_AGENT_PORT=7891
# VESPER_CUA_MODE=standard          # or "bounded" (needs VESPER_CUA_MANIFEST)
# VESPER_CUA_MANIFEST=
